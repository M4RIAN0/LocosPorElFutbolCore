@using LXF.Web.Models.ViewModels
@model IEnumerable<ComprobanteGetViewModel>

<div class="container mt-4 text-light">
    <h2 class="mb-4">Mis Compras</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-dark bg-dark border-secondary text-center p-5 shadow">
            <i class="bi bi-cart-x fs-1 text-secondary"></i>
            <p class="mt-3 fs-5 text-secondary">Aún no tienes compras registradas.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success mt-2">Ver Catálogo</a>
        </div>
    }
    else
    {
        @foreach (var grupoFecha in Model
            .OrderByDescending(c => DateTime.Parse(c.Fecha))
            .GroupBy(c => c.Fecha))
        {
            var fechaEncabezado = DateTime.Parse(grupoFecha.Key).ToString("dd/MM/yyyy");

            <div class="mb-5 border border-secondary rounded shadow-sm overflow-hidden">
                <div class="bg-dark p-3 border-bottom border-secondary">
                    <span class="text-secondary fw-bold text-uppercase" style="font-size: 0.85rem;">@fechaEncabezado</span>
                </div>

                @foreach (var comprobante in grupoFecha)
                {
                    <div class="card bg-dark border-0 rounded-0 @(comprobante != grupoFecha.Last() ? "border-bottom border-secondary" : "")">
                        <div class="card-body p-4">
                            <div class="row align-items-center">

                                <div class="col-md-6">
                                    <div class="d-flex align-items-center">
                                        @{
                                            var detalles = comprobante.DetalleComprobantes?.ToList() ?? new List<DetalleComprobanteGetViewModel>();
                                            var totalItems = detalles.Count;
                                            var totalUnidades = 1;
                                            var itemsParaImagen = detalles.Take(4).ToList();

                                            // Simulación de estados para la demo
                                            var estado = totalItems % 3;
                                        }

                                        <div class="collage-container me-4">
                                            <div class="product-grid grid-@itemsParaImagen.Count">
                                                @foreach (var item in itemsParaImagen)
                                                {
                                                    <div class="grid-item">
                                                        <img src="/images/placeholder-product.png" class="img-fluid" alt="Producto">
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <div class="flex-grow-1">
                                            @if (estado == 0)
                                            {
                                                <h5 class="mb-1 fw-bold" style="color: #81c784;">Entregado</h5>
                                            }
                                            else if (estado == 1)
                                            {
                                                <h5 class="mb-1 fw-bold" style="color: #ffd54f;">Estamos preparando tu pedido para enviarlo</h5>
                                            }
                                            else
                                            {
                                                <h5 class="mb-1 fw-bold" style="color: #64b5f6;">Envío en camino</h5>
                                            }

                                            <div class="text-secondary mb-1">
                                                @if (totalItems == 1)
                                                {
                                                    <span class="d-block fw-semibold text-light">@detalles[0].ProductoNombre</span>
                                                    totalUnidades = detalles[0].Cantidad;
                                                    if (totalUnidades > 1 )
                                                    {
                                                        <small class="text-muted">@totalUnidades unidades | Código: @detalles[0].CodigoBarra</small>
                                                    }
                                                    if (totalUnidades == 1)
                                                    {
                                                        <small class="text-muted">@totalUnidades unidad | Código: @detalles[0].CodigoBarra</small>
                                                    }
                                                    
                                                }
                                                else
                                                {
                                                    <span class="d-block fw-semibold text-light">@totalItems productos en esta compra:</span>
                                                    <ul class="list-unstyled mb-0 mt-1" style="font-size: 0.85rem; color: #adb5bd;">
                                                        @foreach (var item in detalles.Take(2))
                                                        {
                                                            <li>• @item.ProductoNombre (@item.Cantidad un.)</li>
                                                        }
                                                        @if (totalItems > 2)
                                                        {
                                                            <li class="fst-italic">... y @(totalItems - 2) más</li>
                                                        }
                                                    </ul>
                                                }
                                            </div>

                                            <div class="mt-3">
                                                <div class="d-inline-block px-3 py-2 rounded" style="background-color: rgba(255,255,255,0.05); border: 1px solid #343a40;">
                                                    <span class="text-secondary small">Total pagado:</span>
                                                    <span class="text-white fw-bold ms-1">@comprobante.Total.ToString("C")</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        @if (estado == 1 || estado == 2)
                                        {
                                            <a asp-action="Seguimiento" asp-route-id="@comprobante.Id" class="btn btn-primary fw-bold py-2 px-4 shadow-sm">Seguir envío</a>
                                        }
                                        <a asp-action="VerDetalle" asp-route-id="@comprobante.Id" class="btn btn-primary fw-bold py-2 px-4 shadow-sm">Ver compra</a>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<style>
    /* Estilos del Collage con Grilla Equilibrada */
    .collage-container {
        width: 100px;
        height: 100px;
        background-color: #fff;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #343a40;
        flex-shrink: 0;
    }

    .product-grid {
        display: grid;
        width: 100%;
        height: 100%;
        gap: 1px;
        background-color: #343a40;
    }

    /* Grilla 1: Ocupa todo */
    .grid-1 {
        grid-template-columns: 1fr;
    }

    /* Grilla 2: 50/50 exacto */
    .grid-2 {
        grid-template-columns: 1fr 1fr;
    }

    /* Grilla 3: 1 grande izquierda, 2 pequeñas derecha */
    .grid-3 {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr 1fr;
    }

        .grid-3 .grid-item:first-child {
            grid-row: 1 / span 2;
        }

    /* Grilla 4: 2x2 exacto */
    .grid-4 {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr 1fr;
    }

    .grid-item {
        background-color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

        .grid-item img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 2px;
        }

    /* Botones Similares */
    .btn-primary {
        background-color: #3483fa;
        border: none;
        white-space: nowrap; /* Evita que el texto se rompa en dos líneas */
    }

        .btn-primary:hover {
            background-color: #2968c8;
        }

    .card {
        transition: background-color 0.2s;
    }

        .card:hover {
            background-color: #212529 !important;
        }
</style>