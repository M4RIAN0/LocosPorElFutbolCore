@using LXF.Web.Models.ViewModels
@model ProductoViewModel

<style>
    /* Ocultar flechas numéricas y estilos base */
    input[type="number"]::-webkit-outer-spin-button,
    input[type="number"]::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
    input[type="number"] { -moz-appearance: textfield; }
    
    /* Clase para bloquear interacciones sin perder el valor en el POST */
    .readonly-select {
        pointer-events: none;
        opacity: 0.6;
    }
</style>

<form asp-action="Create" enctype="multipart/form-data" id="createProductForm">
    <br />
    <div class="container border border-secondary p-4 bg-dark text-light" style="border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.5);">

        <div class="row mb-4 text-center">
            <h2 class="text-secondary fw-bold text-uppercase tracking-wide">
                <i class="bi bi-box-seam me-2"></i> Crear Producto
            </h2>
        </div>

        <div class="row">
            <!-- COLUMNA IZQUIERDA: DATOS -->
            <div class="col-12 col-lg-8 pe-lg-4">
                <div class="row">
                    <div class="col-12 col-md-8 pb-3">
                        <label class="form-label fw-bold mb-1" style="font-size: 0.9rem; color: #adb5bd;">Nombre</label>
                        <input asp-for="Nombre" class="form-control bg-dark text-light border-secondary" placeholder="Ej: Zapatillas Nike..." />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-4 pb-3">
                        <label class="form-label fw-bold mb-1" style="font-size: 0.9rem; color: #adb5bd;">Precio</label>
                        <input asp-for="Precio" value="@(Model?.Precio > 0 ? Model.Precio.ToString("0.##") : "")" id="precioInput" type="number" step="1" max="99999" class="form-control bg-dark text-light border-secondary" placeholder="Máx 99999" />
                        <span asp-validation-for="Precio" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 pb-3">
                        <label class="form-label fw-bold mb-1" style="font-size: 0.9rem; color: #adb5bd;">Descripción</label>
                        <textarea asp-for="Descripcion" class="form-control bg-dark text-light border-secondary" rows="2" placeholder="Detalles, materiales..."></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 col-md-4 pb-3">
                        <label class="form-label fw-bold mb-1" style="font-size: 0.9rem; color: #adb5bd;">Categoría</label>
                        <select id="selectCategoria" asp-for="CategoriaId" class="form-select bg-dark text-light border-secondary" asp-items="@ViewBag.Categorias">
                            <option value="" disabled selected>-- Seleccionar --</option>
                        </select>
                        <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-4 pb-3">
                        <label class="form-label fw-bold mb-1" style="font-size: 0.9rem; color: #adb5bd;">Marca</label>
                        <select asp-for="MarcaId" class="form-select bg-dark text-light border-secondary" asp-items="@ViewBag.Marcas">
                            <option value="" disabled selected>-- Seleccionar --</option>
                        </select>
                        <span asp-validation-for="MarcaId" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-4 pb-3">
                        <label class="form-label fw-bold mb-1" style="font-size: 0.9rem; color: #adb5bd;">Género</label>
                        <select asp-for="Genero" class="form-select bg-dark text-light border-secondary" asp-items="@ViewBag.Generos">
                            <option value="" disabled selected>-- Seleccionar --</option>
                        </select>
                        <span asp-validation-for="Genero" class="text-danger small"></span>
                    </div>
                </div>

                <!-- SECCIÓN DINÁMICA: VARIANTES -->
                <div class="border border-secondary p-3 mt-2 rounded bg-dark" style="background-color: rgba(0,0,0,0.15) !important;">
                    <h6 class="text-secondary fw-bold mb-3"><i class="bi bi-tags"></i> Talles</h6>
                    
                    <div class="row align-items-end mb-3">
                        <div class="col-md-3">
                            <label class="form-label small text-muted mb-1">Talle</label>
                            <select id="varTalle" class="form-select form-select-sm bg-dark text-light border-secondary" disabled>
                                <option value="" disabled selected>-- Elija Categoría --</option>
                                @if (ViewBag.Talles != null)
                                {
                                    foreach (var talle in ViewBag.Talles)
                                    {
                                        <option value="@talle.Value" data-es-numero="@(talle.EsNumero ? "true" : "false")">@talle.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-muted mb-1">Stock</label>
                            <input id="varStock" type="number" class="form-control form-control-sm bg-dark text-light border-secondary">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted mb-1">Cod. Barra (6 núm)</label>
                            <input id="varSku" type="text" maxlength="6" inputmode="numeric" class="form-control form-control-sm bg-dark text-light border-secondary">
                        </div>
                        <div class="col-md-2">
                            <button type="button" id="btnAgregarVariante" class="btn btn-sm btn-outline-light w-100 fw-bold">Agregar</button>
                        </div>
                    </div>
                    
                    <span id="variantesError" class="text-danger small d-block mb-2" style="display:none;"></span>
                    
                    <div class="table-responsive">
                        <table class="table table-dark table-sm table-bordered border-secondary mb-0" id="tablaVariantes">
                            <thead class="text-secondary">
                                <tr>
                                    <th>Talle</th>
                                    <th>Stock</th>
                                    <th>Cod. Barra</th>
                                    <th class="text-center">Quitar</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Filas generadas por JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- COLUMNA DERECHA: IMAGEN -->
            <div class="col-12 col-lg-4 mt-4 mt-lg-0">
                <div class="border border-secondary p-3 text-center" style="border-radius: 8px; border-style: dashed !important; background-color: rgba(255,255,255,0.02);">
                    <label class="form-label fw-bold mb-3" style="color: #adb5bd;">Imagen</label>

                    <div class="mb-3 d-flex justify-content-center align-items-center overflow-hidden bg-black" style="height: 250px; border-radius: 6px;">
                        <img id="imgPreview" src="https://placehold.co/400x400/1a1a1a/666666?text=Subir+Imagen" class="img-fluid object-fit-cover w-100 h-100" alt="Vista Previa" />
                    </div>

                    <div class="input-group input-group-sm mb-2">
                        <input type="file" id="imagenArchivo" name="imagenArchivo" class="form-control bg-dark text-light border-secondary form-control-sm" accept="image/*" />
                    </div>
                    <small class="text-muted d-block mb-2" style="font-size: 0.75rem;">Formatos: JPG, PNG. Max 2MB.</small>

                    <span id="imagenError" class="text-danger fw-bold small" style="display: none;"><i class="bi bi-exclamation-triangle-fill"></i> Debes subir una imagen.</span>
                    <input type="hidden" asp-for="ImagenUrl" id="ImagenUrlHidden" />
                </div>
            </div>
        </div>

        <hr class="border-secondary my-4">

        <div class="row">
            <div class="col-12 d-flex justify-content-end gap-3">
                <a asp-action="Index" class="btn btn-outline-light px-4">Cancelar</a>
                <button type="submit" class="btn btn-success px-5 fw-bold">Guardar</button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            let variantes = [];

            // 1. CARGAR DATOS SI EL MODELO VUELVE CON ERRORES DEL BACKEND
            @if(Model != null && Model.ProductosVariantes != null && Model.ProductosVariantes.Any())
            {
                foreach(var v in Model.ProductosVariantes)
                {
                    @:variantes.push({ talle: '@v.Talle', stock: '@v.Stock', sku: '@v.CodigoBarra' });
                }
            }

            // IMAGEN PREVIEW
            $('#imagenArchivo').change(function(event) {
                const file = event.target.files[0];
                if (file) {
                    $('#imagenError').fadeOut();
                    const reader = new FileReader();
                    reader.onload = e => $('#imgPreview').attr('src', e.target.result).hide().fadeIn(300);
                    reader.readAsDataURL(file);
                } else {
                    $('#imgPreview').attr('src', 'https://placehold.co/400x400/1a1a1a/666666?text=Subir+Imagen');
                }
            });

            // FILTRADO DINÁMICO DE TALLES
            var $selectTalle = $('#varTalle');
            var $opcionesTalles = $selectTalle.find('option[data-es-numero]').clone();

            function actualizarTalles() {
                var categoriaTexto = $('#selectCategoria').find('option:selected').text().toLowerCase();
                var esZapatilla = categoriaTexto.includes('zapatillas') || categoriaTexto.includes('calzado');

                $selectTalle.empty().append('<option value="" disabled selected>-- Seleccionar Talle --</option>');
                $opcionesTalles.each(function() {
                    var esNumero = $(this).attr('data-es-numero') === 'true';
                    if ((esZapatilla && esNumero) || (!esZapatilla && !esNumero)) {
                        $selectTalle.append($(this).clone());
                    }
                });
                
                if($('#selectCategoria').val()) {
                    $selectTalle.prop('disabled', false);
                }
            }

            $('#selectCategoria').change(actualizarTalles);
            
            // Si vuelve poblado del backend, cargar talles automáticamente
            if($('#selectCategoria').val()) {
                actualizarTalles();
            }

            // BLOQUEO DE CATEGORÍA CUANDO HAY TALLES AGREGADOS
            function gestionarBloqueoCategoria() {
                if (variantes.length > 0) {
                    $('#selectCategoria').addClass('readonly-select');
                } else {
                    $('#selectCategoria').removeClass('readonly-select');
                }
            }

            // RESTRICCIONES DE INPUTS (Precio Máx 5 dígitos)
            $('#precioInput').on('keydown', function(e) {
                if (['e', 'E', '+', '-'].includes(e.key)) { e.preventDefault(); }
            });
            $('#precioInput').on('input', function() {
                if (this.value.length > 5) { this.value = this.value.slice(0, 5); }
                if (parseInt(this.value) > 99999) { this.value = 99999; }
            });

            // STOCK MÁX 3 DÍGITOS Y COD BARRA 6
            $('#varSku').on('input', function() { this.value = this.value.replace(/[^0-9]/g, '').slice(0, 6); });
            
            $('#varStock').on('keydown', function(e) {
                if (['e', 'E', '+', '-', '.', ','].includes(e.key)) { e.preventDefault(); }
            });
            $('#varStock').on('input', function() {
                this.value = this.value.replace(/[^0-9]/g, '');
                if (this.value.length > 3) { this.value = this.value.slice(0, 3); }
                if (parseInt(this.value) > 999) { this.value = 999; }
            });

            $('#varSku, #varStock').on('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    $('#btnAgregarVariante').click();
                }
            });

            // RENDERIZAR TABLA DE VARIANTES
            function renderTabla() {
                let html = '';
                variantes.forEach((v, index) => {
                    html += `<tr>
                        <td class="align-middle">${v.talle}
                            <input type="hidden" name="ProductosVariantes[${index}].Talle" value="${v.talle}" />
                        </td>
                        <td class="align-middle">${v.stock}
                            <input type="hidden" name="ProductosVariantes[${index}].Stock" value="${v.stock}" />
                        </td>
                        <td class="align-middle">${v.sku}
                            <input type="hidden" name="ProductosVariantes[${index}].CodigoBarra" value="${v.sku}" />
                        </td>
                        <td class="text-center align-middle">
                            <button type="button" class="btn btn-sm btn-outline-danger py-0" onclick="eliminarVariante(${index})"><i class="bi bi-x-lg"></i></button>
                        </td>
                    </tr>`;
                });
                $('#tablaVariantes tbody').html(html);
                gestionarBloqueoCategoria();
            }

            window.eliminarVariante = function(index) {
                variantes.splice(index, 1);
                renderTabla();
            }

            // AGREGAR VARIANTE
            $('#btnAgregarVariante').click(function() {
                const talle = $('#varTalle').val();
                const stock = $('#varStock').val();
                const sku = $('#varSku').val();
                const $error = $('#variantesError');
                
                if(!talle || !stock || sku.length !== 6) {
                    $error.text('Seleccione talle, ingrese stock válido y un Cod. Barra de 6 dígitos.').fadeIn();
                    return;
                }
                if(variantes.some(v => v.talle === talle)) {
                    $error.text('El talle seleccionado ya fue agregado a la tabla.').fadeIn();
                    return;
                }
                if(variantes.some(v => v.sku === sku)) {
                    $error.text('El Cod. Barra ingresado ya existe en la tabla.').fadeIn();
                    return;
                }

                variantes.push({ talle: talle, stock: stock, sku: sku });
                renderTabla();
                
                // Ocultar mensaje de error de inmediato
                $error.fadeOut();
                
                // Reset limpio
                $('#varTalle').prop('selectedIndex', 0);
                $('#varStock').val('');
                $('#varSku').val('');
            });

            // VALIDACION FINAL SUBMIT
            $('#createProductForm').submit(function(e) {
                let valid = true;

                if ($('#imagenArchivo').val() === '' && !$('#ImagenUrlHidden').val()) {
                    $('#imagenError').fadeIn();
                    valid = false;
                } else {
                    $('#imagenError').fadeOut();
                }
                
                if (variantes.length === 0) {
                    $('#variantesError').text('Debe agregar al menos un talle con su stock y código.').fadeIn();
                    valid = false;
                } else {
                    $('#variantesError').fadeOut();
                }

                if (!valid) {
                    e.preventDefault();
                }
            });

            // Llamada inicial por si el formulario vuelve con errores
            renderTabla();
        });
    </script>
}