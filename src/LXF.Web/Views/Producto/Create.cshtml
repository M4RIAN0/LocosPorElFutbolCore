@using LXF.Web.Models.ViewModels

@model ProductoViewModel

<style>
    /* Ocultar flechas de inputs numéricos en Chrome, Safari, Edge y Opera */
    input[type="number"]::-webkit-outer-spin-button,
    input[type="number"]::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    /* Ocultar flechas de inputs numéricos en Firefox */
    input[type="number"] {
        -moz-appearance: textfield;
    }
</style>

<form asp-action="Create" enctype="multipart/form-data" id="createProductForm">
    <br />
    <div class="container border border-secondary p-4 bg-dark text-light" style="border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.5);">

        <div class="row mb-4 text-center">
            <h2 class="text-secondary fw-bold text-uppercase tracking-wide">
                <i class="bi bi-box-seam me-2"></i> Crear Producto
            </h2>
        </div>

        <div class="row">
            <!-- COLUMNA IZQUIERDA: DATOS -->
            <div class="col-12 col-lg-8 pe-lg-4">
                <div class="row">
                    <div class="col-12 col-md-6 pb-3">
                        <label class="form-label fw-bold mb-1" style="font-size: 0.9rem; color: #adb5bd;">Nombre</label>
                        <input asp-for="Nombre" class="form-control bg-dark text-light border-secondary" placeholder="Ej: Zapatillas Nike..." />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6 pb-3">
                        <label class="form-label fw-bold mb-1" style="font-size: 0.9rem; color: #adb5bd;">Código de Barra (SKU)</label>
                        <input asp-for="CodigoBarra" id="codigoBarraInput" type="text" maxlength="6" inputmode="numeric" class="form-control bg-dark text-light border-secondary" placeholder="Ej: 779123" />
                        <span asp-validation-for="CodigoBarra" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 pb-3">
                        <label class="form-label fw-bold mb-1" style="font-size: 0.9rem; color: #adb5bd;">Descripción</label>
                        <textarea asp-for="Descripcion" class="form-control bg-dark text-light border-secondary" rows="3" placeholder="Detalles, materiales..."></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 col-md-6 pb-3">
                        <label class="form-label fw-bold mb-1" style="font-size: 0.9rem; color: #adb5bd;">Categoría</label>
                        <select id="selectCategoria" asp-for="CategoriaId" class="form-select bg-dark text-light border-secondary" asp-items="@ViewBag.Categorias">
                            <option value="" disabled selected>-- Seleccionar --</option>
                        </select>
                        <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6 pb-3">
                        <label class="form-label fw-bold mb-1" style="font-size: 0.9rem; color: #adb5bd;">Talle</label>
                        <select id="selectTalle" asp-for="Talle" class="form-select bg-dark text-light border-secondary" disabled>
                            <option value="" disabled selected>-- Elija Categoría --</option>
                            @if (ViewBag.Talles != null)
                            {
                                foreach (var talle in ViewBag.Talles)
                                {
                                    <option value="@talle.Value" data-es-numero="@(talle.EsNumero ? "true" : "false")">
                                        @talle.Text
                                    </option>
                                }
                            }
                        </select>
                        <span asp-validation-for="Talle" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 col-md-4 pb-3">
                        <label class="form-label fw-bold mb-1" style="font-size: 0.9rem; color: #adb5bd;">Marca</label>
                        <select asp-for="MarcaId" class="form-select bg-dark text-light border-secondary" asp-items="@ViewBag.Marcas">
                            <option value="" disabled selected>-- Seleccionar --</option>
                        </select>
                        <span asp-validation-for="MarcaId" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-4 pb-3">
                        <label class="form-label fw-bold mb-1" style="font-size: 0.9rem; color: #adb5bd;">Precio</label>
                        <input asp-for="Precio" id="precioInput" type="number" step="0.01" class="form-control bg-dark text-light border-secondary" />
                        <span asp-validation-for="Precio" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-4 pb-3">
                        <label class="form-label fw-bold mb-1" style="font-size: 0.9rem; color: #adb5bd;">Stock</label>
                        <input asp-for="Stock" id="stockInput" type="number" class="form-control bg-dark text-light border-secondary" />
                        <span asp-validation-for="Stock" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- COLUMNA DERECHA: IMAGEN -->
            <div class="col-12 col-lg-4 mt-4 mt-lg-0">
                <div class="border border-secondary p-3 text-center" style="border-radius: 8px; border-style: dashed !important; background-color: rgba(255,255,255,0.02);">
                    <label class="form-label fw-bold mb-3" style="color: #adb5bd;">Imagen</label>

                    <div class="mb-3 d-flex justify-content-center align-items-center overflow-hidden bg-black" style="height: 250px; border-radius: 6px;">
                        <img id="imgPreview" src="https://placehold.co/400x400/1a1a1a/666666?text=Subir+Imagen" class="img-fluid object-fit-cover w-100 h-100" alt="Vista Previa" />
                    </div>

                    <div class="input-group input-group-sm mb-2">
                        <input type="file" id="imagenArchivo" name="imagenArchivo" class="form-control bg-dark text-light border-secondary form-control-sm" accept="image/*" />
                    </div>
                    <small class="text-muted d-block mb-2" style="font-size: 0.75rem;">Formatos: JPG, PNG, WEBP. Max 2MB.</small>

                    <span id="imagenError" class="text-danger fw-bold small" style="display: none;">
                        <i class="bi bi-exclamation-triangle-fill"></i> Debes subir una imagen del producto.
                    </span>
                    <span asp-validation-for="ImagenUrl" class="text-danger small"></span>

                    <input type="hidden" asp-for="ImagenUrl" id="ImagenUrlHidden" />
                </div>
            </div>
        </div>

        <hr class="border-secondary my-4">

        <div class="row">
            <div class="col-12 d-flex justify-content-end gap-3">
                <a asp-action="Index" class="btn btn-outline-light px-4">Cancelar</a>
                <button type="submit" class="btn btn-success px-5 fw-bold">Guardar</button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function() {

            // 1. VALIDACIÓN DE IMAGEN
            $('#createProductForm').submit(function(e) {
                if ($('#imagenArchivo').val() === '') {
                    $('#imagenError').fadeIn();
                    e.preventDefault();
                    return false;
                }
            });

            $('#imagenArchivo').change(function(event) {
                const file = event.target.files[0];
                if (file) {
                    $('#imagenError').fadeOut();
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        $('#imgPreview').attr('src', e.target.result).hide().fadeIn(300);
                    }
                    reader.readAsDataURL(file);

                    $('#ImagenUrlHidden').val(file.name);
                } else {
                    $('#ImagenUrlHidden').val('');
                    $('#imgPreview').attr('src', 'https://placehold.co/400x400/1a1a1a/666666?text=Subir+Imagen');
                }
            });

            // 2. RESTRICCIONES FÍSICAS DE TECLADO
            $('#codigoBarraInput').on('input', function() {
                this.value = this.value.replace(/[^0-9]/g, '');
                if (this.value.length > 6) {
                    this.value = this.value.slice(0, 6);
                }
            });

            $('#stockInput').on('keydown', function(e) {
                if (['e', 'E', '+', '-', '.', ','].includes(e.key)) {
                    e.preventDefault();
                }
            });
            $('#stockInput').on('input', function() {
                if (this.value.length > 3) {
                    this.value = this.value.slice(0, 3);
                }
                if (parseInt(this.value) > 100) {
                    this.value = 100;
                }
            });

            $('#precioInput').on('keydown', function(e) {
                if (['e', 'E', '+', '-'].includes(e.key)) {
                    e.preventDefault();
                }
            });
            $('#precioInput').on('input', function() {
                if (this.value.length > 8) {
                    this.value = this.value.slice(0, 8);
                }
                if (parseFloat(this.value) > 99999.99) {
                    this.value = 99999.99;
                }
            });

            // 3. FILTRADO DINÁMICO DE TALLES
            var $selectTalle = $('#selectTalle');
            var $opcionesTalles = $selectTalle.find('option[data-es-numero]').clone();

            $('#selectCategoria').change(function() {
                var categoriaTexto = $(this).find('option:selected').text().toLowerCase();
                var esZapatilla = categoriaTexto.includes('zapatillas') || categoriaTexto.includes('calzado');

                $selectTalle.empty().append('<option value="" disabled selected>--Seleccionar Talle--</option>');

                $opcionesTalles.each(function() {
                    var esNumero = $(this).attr('data-es-numero') === 'true';
                    if ((esZapatilla && esNumero) || (!esZapatilla && !esNumero)) {
                        $selectTalle.append($(this).clone());
                    }
                });

                $selectTalle.prop('disabled', false);
            });
        });
    </script>
}