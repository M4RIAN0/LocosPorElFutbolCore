@using LXF.Web.Models.ViewModels

@model ProductoGetViewModel

<form asp-action="Delete">
    <br />
    <div class="container border p-3">
        <h1 class="text-white text-center">Eliminar Producto</h1>
        <input asp-for="Id" hidden />
        <hr />
        <div class="row">
            <div class="col-2">
                <label class="control-label pt-2" style="font-size:20px;">Nombre</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="Nombre" disabled class="form-control" />
            </div>
            <div class="col-2">
                <label class="control-label pt-2" style="font-size:20px;">Descripcion</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="Descripcion" disabled class="form-control" />
            </div>
            <div class="col-2">
                <label class="control-label pt-2" style="font-size:20px;">Marca</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="Marca" disabled class="form-control" />
            </div>
            <div class="col-2">
                <label class="control-label pt-2" style="font-size:20px;">Talle</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="Talle" disabled class="form-control" />
            </div>
            <div class="col-2">
                <label class="control-label pt-2" style="font-size:20px;">Precio</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="Precio" disabled class="form-control" />
            </div>
            <div class="col-2">
                <label class="control-label pt-2" style="font-size:20px;">Stock</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="Stock" disabled class="form-control" />
            </div>
            <div class="col-2">
                <label class="control-label pt-2" style="font-size:20px;">CodigoBarra</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="CodigoBarra" disabled class="form-control" />
            </div>
            <div class="col-2">
                <label class="control-label pt-2" style="font-size:20px;">Categoria</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="Categoria" disabled class="form-control" />
            </div>

            <div class="col-5 offset-2">
                <a asp-action="Index" class="btn-primary btn form-control ">Volver a la Lista</a>
            </div>
            <div class="col-5">
                <input type="submit" value="Eliminar" class="btn btn-danger form-control" />
            </div>
        </div>
    </div>
</form>