@using LXF.Web.Models.ViewModels
@model CarroComprasGetViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    string direccionRegistrada = ViewBag.Direccion as string ?? "Dirección no proporcionada en el registro.";
    string minWordsMessage = "Ingrese al menos dos palabras (Nombre y Apellido).";
    string orangeColor = "#ffc107"; 
    string lightOrangeBg = "rgba(255, 193, 7, 0.1)"; 
}

<form method="post" id="checkoutForm" asp-controller="Venta" asp-action="Pay">

    @* Inputs vitales para la Orden de Compra *@
    <input asp-for="UserId" hidden />
    <input asp-for="Id" hidden />
    <input type="hidden" name="PersonaClienteId" value="@ViewBag.PersonaClienteId" />
    <input type="hidden" name="Fecha" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
    <input asp-for="Total" id="hiddenTotalOrden" hidden />
    <input type="hidden" name="Nombre" id="hiddenNombreOrden" value="" />
    <input type="hidden" name="Email" id="hiddenEmailOrden" value="" />
    <input type="hidden" name="Celular" id="hiddenCelularOrden" value="" />
    <input type="hidden" name="Status" value="Pagada" />
    <input type="hidden" name="CarroId" value="@Model.Id" />

    @* Inputs de Factura *@
    <input asp-for="@Model.Factura.Direccion" id="Factura_Direccion" hidden />
    <input type="hidden" name="Factura.Fecha" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
    <input type="hidden" name="Factura.Total" id="hiddenTotalFactura" value="@Model.Total" />
    <input type="hidden" name="Factura.Estado" value="Pagada" />
    <input type="hidden" name="Factura.TipoPago" value="Tarjeta" />

    @* Inputs de Envío *@
    <input asp-for="@Model.Envio.Direccion" id="Envio_Direccion" hidden />
    <input type="hidden" name="Envio.Estado" value="Compra confirmada" />
    <input type="hidden" id="Envio_Monto" name="Envio.Monto" value="0" />

    @for (int i = 0; i < Model.DetalleCarroCompras.Count(); i++)
    {
        <input type="hidden" name="DetalleOrdenCompras[@i].Cantidad" value="@Model.DetalleCarroCompras.ElementAt(i).Cantidad" />
        <input type="hidden" name="DetalleOrdenCompras[@i].Precio" value="@Model.DetalleCarroCompras.ElementAt(i).Precio" />
        <input type="hidden" name="DetalleOrdenCompras[@i].SubTotal" value="@Model.DetalleCarroCompras.ElementAt(i).SubTotal" />
        <input type="hidden" name="DetalleOrdenCompras[@i].ProductoVarianteId" value="@Model.DetalleCarroCompras.ElementAt(i).ProductoVarianteId" />
        <input type="hidden" name="DetalleOrdenCompras[@i].CarroComprasId" value="@Model.DetalleCarroCompras.ElementAt(i).CarroComprasId" />
    }

    <div class="container mt-4 text-light">
        
        <!-- Encabezado Limpio -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-warning mb-0">Confirmar Compra</h2>
            <a asp-controller="Carro" asp-action="Index" class="btn btn-outline-warning">Volver al Carrito</a>
        </div>

        <div class="row g-4">
            
            <!-- COLUMNA IZQUIERDA: FORMULARIOS -->
            <div class="col-lg-7">
                
                <!-- Tarjeta Facturación -->
                <div class="card bg-dark border-secondary mb-4 shadow-sm">
                    <div class="card-header border-secondary bg-transparent pt-3">
                        <h5 class="text-warning mb-0">Datos para Facturación</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <input asp-for="Factura.Nombre" placeholder="Nombre Completo..." maxlength="100" class="form-control bg-dark text-light border-secondary"
                                       data-val="true" data-val-required="El Nombre Completo es Obligatorio."
                                       data-rule-minwords="2" data-msg-minwords="@minWordsMessage" />
                                <span asp-validation-for="Factura.Nombre" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <input asp-for="@Model.Factura.Dni" id="dniFacturacionInput" placeholder="DNI..." maxlength="8" inputmode="numeric" class="form-control bg-dark text-light border-secondary"
                                       data-val="true" data-val-required="El DNI es Obligatorio." />
                                <span asp-validation-for="@Model.Factura.Dni" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <input asp-for="@Model.Factura.Celular" id="celularFacturacionInput" class="form-control bg-dark text-light border-secondary" placeholder="Celular..." maxlength="10" inputmode="numeric"
                                       data-val="true" data-val-required="El Celular es Obligatorio." />
                                <span asp-validation-for="@Model.Factura.Celular" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <input asp-for="@Model.Factura.Email" placeholder="Email..." maxlength="100" type="email" class="form-control bg-dark text-light border-secondary"
                                       data-val="true" data-val-required="El Email es Obligatorio." data-val-email="Ingrese un correo válido." required />
                                <span asp-validation-for="@Model.Factura.Email" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tarjeta Envío -->
                <div class="card bg-dark border-secondary shadow-sm">
                    <div class="card-header border-secondary bg-transparent pt-3 d-flex justify-content-between align-items-center">
                        <h5 class="text-warning mb-0">Datos para el Envío</h5>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" id="checkNuevaDireccion" style="background-color: @orangeColor; border-color: @orangeColor;">
                            <label class="form-check-label text-warning small" for="checkNuevaDireccion">Nueva dirección</label>
                        </div>
                    </div>
                    <div class="card-body">
                        
                        <div id="direccion-existente" class="p-3 border rounded border-secondary bg-dark text-light mb-3">
                            <small class="d-block text-muted mb-1">Dirección registrada:</small>
                            <p class="mb-0 text-break fw-bold">@direccionRegistrada</p>
                        </div>

                        <div id="direccion-nueva-form" class="mt-2" style="display:none;">
                            <div class="p-2 small border rounded mb-3" style="background-color: @lightOrangeBg; border-color: @orangeColor !important; color: @orangeColor;" role="alert">
                                Ingrese la nueva dirección completa.
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-md-8">
                                    <input name="Calle" id="calleInput" type="text" class="form-control bg-dark text-light border-secondary" placeholder="Calle..."
                                           data-val="true" data-val-required="La calle es obligatoria." />
                                    <span data-valmsg-for="Calle" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <input name="Numero" id="numeroCalleInput" type="text" class="form-control bg-dark text-light border-secondary" placeholder="Número..." inputmode="numeric" maxlength="5"
                                           data-val="true" data-val-required="Numero Obligatorio." />
                                    <span data-valmsg-for="Numero" class="text-danger small"></span>
                                </div>
                                <div class="col-6">
                                    <input name="Piso" id="pisoInput" type="text" class="form-control bg-dark text-light border-secondary" placeholder="Piso (Opcional)" inputmode="numeric" maxlength="3" />
                                </div>
                                <div class="col-6">
                                    <input name="Departamento" id="deptoInput" type="text" class="form-control bg-dark text-light border-secondary" placeholder="Depto (Opcional)" maxlength="3" />
                                </div>
                                <div class="col-6">
                                    <select name="Provincia" id="provinciaInput" asp-items="@(ViewData["Provincias"] as SelectList)" class="form-select bg-dark text-light border-secondary"
                                            data-val="true" data-val-required="Seleccione Provincia.">
                                        <option value="" selected disabled>Provincia...</option>
                                    </select>
                                    <span data-valmsg-for="Provincia" class="text-danger small"></span>
                                </div>
                                <div class="col-6">
                                    <select name="Localidad" id="localidadInput" class="form-select bg-dark text-light border-secondary" disabled
                                            data-val="true" data-val-required="Seleccione Localidad.">
                                        <option value="" selected disabled>Localidad...</option>
                                    </select>
                                    <span data-valmsg-for="Localidad" class="text-danger small"></span>
                                </div>
                            </div>
                            <hr class="border-secondary my-3" />
                        </div>

                        <div class="row g-3">
                            <div class="col-12">
                                <input asp-for="@Model.Envio.Persona" placeholder="Nombre de quien recibe..." maxlength="100" class="form-control bg-dark text-light border-secondary"
                                       data-val="true" data-val-required="El Nombre del Receptor es Obligatorio."
                                       data-rule-minwords="2" data-msg-minwords="@minWordsMessage" />
                                <span asp-validation-for="@Model.Envio.Persona" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <input asp-for="@Model.Envio.Dni" id="dniEnvioInput" placeholder="DNI..." maxlength="8" inputmode="numeric" class="form-control bg-dark text-light border-secondary"
                                       data-val="true" data-val-required="El DNI es Obligatorio." />
                                <span asp-validation-for="@Model.Envio.Dni" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <input asp-for="@Model.Envio.Celular" id="celularEnvioInput" class="form-control bg-dark text-light border-secondary" placeholder="Celular..." maxlength="10" inputmode="numeric"
                                       data-val="true" data-val-required="El Celular es Obligatorio." />
                                <span asp-validation-for="@Model.Envio.Celular" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <input asp-for="@Model.Envio.Email" placeholder="Email de contacto..." maxlength="100" type="email" class="form-control bg-dark text-light border-secondary"
                                       data-val="true" data-val-required="El Email es Obligatorio." data-val-email="Correo inválido." required />
                                <span asp-validation-for="@Model.Envio.Email" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- COLUMNA DERECHA: RESUMEN Y PAGO -->
            <div class="col-lg-5">
                <div class="card bg-dark border-secondary shadow-sm">
                    <div class="card-header border-secondary bg-transparent pt-3">
                        <h5 class="text-warning mb-0">Resumen del Pedido</h5>
                    </div>
                    <div class="card-body">
                        
                        <div class="d-flex justify-content-between text-secondary mb-2 small fw-bold text-uppercase border-bottom border-secondary pb-2">
                            <span>Producto</span>
                            <span>Subtotal</span>
                        </div>
            
                        @foreach (var cartObj in Model.DetalleCarroCompras)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="pe-3">
                                    <span class="d-block text-light fw-semibold">@cartObj.ProductoVariante.Producto.Nombre</span>
                                    <small class="text-secondary">Talle @cartObj.ProductoVariante.Talle | @cartObj.Cantidad un. x $ @cartObj.Precio.ToString("N0")</small>
                                </div>
                                <div class="text-end text-light fw-bold">
                                    $ @cartObj.SubTotal.ToString("N0")
                                </div>
                            </div>
                        }
            
                        <hr class="border-secondary" />
            
                        <!-- SECCIÓN DE ENVÍO DINÁMICO -->
                        <div class="d-flex justify-content-between align-items-center py-2 px-3 rounded" style="background-color: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.1);">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-truck fs-4 me-2 text-warning"></i>
                                <div>
                                    <span class="d-block text-light fw-semibold small">Costo de envío</span>
                                    <small id="subtexto-destino" class="text-secondary micro-text">Cargando ubicación...</small>
                                </div>
                            </div>
                            <div class="text-end">
                                <span id="texto-costo-envio" class="fw-bold fs-6" style="color: #00a650;">
                                    Cargando...
                                </span>
                            </div>
                        </div>
            
                        <hr class="border-secondary" />
            
                        <!-- TOTAL ACTUALIZADO -->
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="fs-5 text-light fw-bold">Total a Pagar:</span>
                            <span id="texto-total-pagar" class="fs-4 text-warning fw-bold" data-subtotal="@Model.Total">
                                $ @Model.Total.ToString("N0")
                            </span>
                        </div>
                    </div>
                    
                    <div class="card-footer border-secondary bg-transparent text-center py-4">
                        <button type="submit" class="btn border-0 p-0 mb-2 btn-mp-final-image">
                            <img src="~/images/Icono_MP.png" alt="Pagar con Mercado Pago" style="max-width: 160px; border-radius: 8px;" />
                        </button>
                        <p class="text-secondary small mb-0"><i class="bi bi-shield-lock-fill me-1"></i>Paga de forma segura</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        // 1. CONSTANTES GLOBALES
        const localidadesData = @Html.Raw(Json.Serialize(ViewBag.LocalidadesData ?? new List<object>()));
        const direccionRegistrada = "@Html.Raw(direccionRegistrada)";
        const subtotalBase = parseFloat($('#texto-total-pagar').data('subtotal'));

        $(document).ready(function () {
            
            // 2. INICIALIZACIÓN UNIFICADA DE MÓDULOS
            configurarValidacionesPersonalizadas();
            configurarMascarasDeEntrada();
            configurarToggleDeDireccion();
            configurarSelectoresDeUbicacion();
            configurarProcesamientoDelFormulario();

            // --- MÓDULOS Y FUNCIONES ---

            function configurarValidacionesPersonalizadas() {
                $.validator.addMethod("minwords", function (value, element, params) {
                    if (this.optional(element)) return true;
                    return value.trim().split(/\s+/).filter(Boolean).length >= params;
                });
                $.validator.unobtrusive.adapters.addBool("minwords");
            }

            function revalidarFormulario() {
                const $form = $("#checkoutForm");
                $form.removeData('validator').removeData('unobtrusiveValidation');
                $.validator.unobtrusive.parse($form);
            }

            function configurarMascarasDeEntrada() {
                const camposNumericos = '#dniFacturacionInput, #dniEnvioInput, #celularFacturacionInput, #celularEnvioInput, #numeroCalleInput, #pisoInput';
                $(document).on('input', camposNumericos, function() {
                    this.value = this.value.replace(/[^0-9]/g, '');
                });
            }

            function obtenerCostoEnvioPorTexto(textoProvincia) {
                if (!textoProvincia) return null;
                const prov = textoProvincia.toLowerCase();

                if (prov.includes('tucum')) return 0;
                if (prov.includes('salta') || prov.includes('jujuy') || prov.includes('catamarca') || prov.includes('santiago')) return 4500;
                if (prov.includes('córdoba') || prov.includes('cordoba') || prov.includes('santa fe') || prov.includes('mendoza')) return 7200;
                if (prov.includes('buenos aires') || prov.includes('entre ríos') || prov.includes('entre rios')) return 9500;
                return 12500;
            }

            function actualizarResumenEnvio(costo, etiquetaDestino) {
                // 1. Asignar el valor del costo al input hidden para que viaje en el POST
                const montoCalculado = costo === null ? 0 : costo;
                $('#Envio_Monto').val(montoCalculado);

                // 2. Sincronizar el total final en los inputs ocultos
                let totalFinal = subtotalBase;
                if (costo !== null) {
                    totalFinal += costo;
                }
                $('#hiddenTotalOrden, #hiddenTotalFactura').val(totalFinal);
            
                // 3. Formato visual
                if (costo === null) {
                    $('#texto-costo-envio').html('Seleccione provincia').css({ 'color': '#6c757d', 'font-weight': 'normal', 'font-size': '0.85rem' });
                    $('#texto-total-pagar').html(`$ ${subtotalBase.toLocaleString('es-AR')}`);
                } else if (costo === 0) {
                    $('#texto-costo-envio').html('GRATIS').css({ 'color': '#00a650', 'font-weight': 'bold', 'font-size': '1rem' });
                    $('#texto-total-pagar').html(`$ ${subtotalBase.toLocaleString('es-AR')}`);
                } else {
                    $('#texto-costo-envio').html(`$ ${costo.toLocaleString('es-AR')}`).css({ 'color': '#00a650', 'font-weight': 'bold', 'font-size': '1rem' });
                    const totalFinal = subtotalBase + costo;
                    $('#texto-total-pagar').html(`$ ${totalFinal.toLocaleString('es-AR')}`);
                }
            
                if (etiquetaDestino) {
                    $('#subtexto-destino').text(etiquetaDestino);
                }                
            }

            function calcularEnvioDireccionPredeterminada() {
                const costo = obtenerCostoEnvioPorTexto(direccionRegistrada);
                
                // Extraer solo "Localidad, Provincia" sin prefijos
                let etiquetaUbicacion = "Dirección registrada";
                if (direccionRegistrada && direccionRegistrada.includes(',')) {
                    const partes = direccionRegistrada.split(',');
                    if (partes.length >= 2) {
                        etiquetaUbicacion = partes.slice(-2).join(',').trim();
                    }
                }
                actualizarResumenEnvio(costo, etiquetaUbicacion);
            }

            function configurarToggleDeDireccion() {
                const $check = $('#checkNuevaDireccion');
                const $camposNuevos = $('#calleInput, #numeroCalleInput, #pisoInput, #deptoInput, #provinciaInput, #localidadInput');

                function aplicarCambioVisual() {
                    if ($check.is(':checked')) {
                        $('#direccion-existente').slideUp();
                        $('#direccion-nueva-form').slideDown();
                        $camposNuevos.prop('disabled', false);

                        const provSeleccionada = $('#provinciaInput option:selected').text();
                        const locSeleccionada = $('#localidadInput option:selected').text();

                        if (provSeleccionada && !provSeleccionada.includes('Provincia')) {
                            const costo = obtenerCostoEnvioPorTexto(provSeleccionada);
                            let etiqueta = provSeleccionada;
                            if (locSeleccionada && !locSeleccionada.includes('Localidad')) {
                                etiqueta = `${locSeleccionada}, ${provSeleccionada}`;
                            }
                            actualizarResumenEnvio(costo, etiqueta);
                        } else {
                            // Sin provincia elegida: costo nulo y subtexto indicativo
                            actualizarResumenEnvio(null, 'Pendiente de selección');
                        }
                    } else {
                        $('#direccion-existente').slideDown();
                        $('#direccion-nueva-form').slideUp();
                        $camposNuevos.prop('disabled', true).val('');
                        $('#localidadInput').prop('disabled', true);
                        $('#direccion-nueva-form').find('span.text-danger').empty();

                        // Restaurar ubicación registrada
                        calcularEnvioDireccionPredeterminada();
                    }
                    revalidarFormulario();
                }

                $check.on('change', aplicarCambioVisual);
                
                // Carga inicial
                calcularEnvioDireccionPredeterminada();
            }

            function configurarSelectoresDeUbicacion() {
                $('#provinciaInput').on('change', function() {
                    const provinciaId = $(this).val();
                    const provinciaTexto = $('#provinciaInput option:selected').text();
                    const $localidadSelect = $('#localidadInput');

                    $localidadSelect.prop('disabled', true).empty().append(new Option('Cargando...', ''));

                    if (provinciaId) {
                        const costo = obtenerCostoEnvioPorTexto(provinciaTexto);
                        actualizarResumenEnvio(costo, provinciaTexto);

                        const filtradas = localidadesData.filter(l => String(l.provinciaId) === provinciaId);
                        
                        $localidadSelect.empty().append(new Option('Seleccione Localidad...', '', true, true));
                        $localidadSelect.find('option').prop('disabled', true);
                        
                        if (filtradas.length > 0) {
                            filtradas.forEach(loc => $localidadSelect.append(new Option(loc.nombre, loc.id)));
                            $localidadSelect.prop('disabled', false);
                        } else {
                            $localidadSelect.empty().append(new Option('Sin localidades', '', true, true)).prop('disabled', true);
                        }
                        revalidarFormulario();
                    }
                });

                $('#localidadInput').on('change', function() {
                    const provinciaTexto = $('#provinciaInput option:selected').text();
                    const localidadTexto = $('#localidadInput option:selected').text();

                    if (localidadTexto && !localidadTexto.includes('Seleccione')) {
                        const costo = obtenerCostoEnvioPorTexto(provinciaTexto);
                        actualizarResumenEnvio(costo, `${localidadTexto}, ${provinciaTexto}`);
                    }
                });
            }

            function configurarProcesamientoDelFormulario() {
                $('#checkoutForm').submit(function (e) {
                    if (!$(this).valid()) {
                        e.preventDefault();
                        return false;
                    }

                    let direccionFinal = "";
                    
                    if ($('#checkNuevaDireccion').is(':checked')) {
                        const calle = $('#calleInput').val().trim();
                        const numero = $('#numeroCalleInput').val().trim();
                        const piso = $('#pisoInput').val().trim();
                        const depto = $('#deptoInput').val().trim();
                        const provincia = $('#provinciaInput option:selected').text();
                        const localidad = $('#localidadInput option:selected').text();

                        if (calle && numero) direccionFinal += `${calle} ${numero}`;
                        
                        let extra = [];
                        if (piso) extra.push(`Piso: ${piso}`);
                        if (depto) extra.push(`Depto: ${depto}`);
                        if (extra.length) direccionFinal += `, ${extra.join(' / ')}`;
                        
                        if (localidad && !localidad.includes('Localidad')) direccionFinal += `, ${localidad}`;
                        if (provincia && !provincia.includes('Provincia')) direccionFinal += `, ${provincia}`;
                    } else {
                        direccionFinal = direccionRegistrada;
                    }

                    $('#Factura_Direccion').val(direccionFinal);
                    $('#Envio_Direccion').val(direccionFinal);
                    $('#hiddenNombreOrden').val($('#Factura_Nombre').val().trim());
                    $('#hiddenEmailOrden').val($('#Factura_Email').val().trim());
                    $('#hiddenCelularOrden').val($('#celularFacturacionInput').val().trim());
                    
                    return true;
                });
            }
        });
    </script>
}