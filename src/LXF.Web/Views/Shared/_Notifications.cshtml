@* Contenido de _Notifications.cshtml *@

<script>
    toastr.options = {
        "positionClass": "toast-top-right",
        "closeButton": true,
        "progressBar": true,
        "timeOut": "5000"
    };

    // 1. Mensaje de ÉXITO
    @if (TempData["success"] != null)
    {
            var message = Html.Raw(Json.Serialize(TempData["success"]));
            <text>
                toastr.success(@message);
            </text>
    }

    // 2. Mensaje de ERROR
    @if (TempData["error"] != null)
    {
            var message = Html.Raw(Json.Serialize(TempData["error"]));
            <text>
                toastr.error(@message);
            </text>
    }

    // 3. Mensaje de ADVERTENCIA (WARNING)
    @if (TempData["warning"] != null)
    {
            var message = Html.Raw(Json.Serialize(TempData["warning"]));
            <text>
                toastr.warning(@message);
            </text>
    }

    // 4. Mensaje de INFORMACIÓN (INFO)
    @if (TempData["info"] != null)
    {
            var message = Html.Raw(Json.Serialize(TempData["info"]));
            <text>
                toastr.info(@message);
            </text>
    }
</script>