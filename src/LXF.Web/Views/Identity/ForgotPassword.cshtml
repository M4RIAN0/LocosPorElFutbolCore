@using LXF.Web.Models.ViewModels
@model ForgotPasswordViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recuperar Contraseña - LXF.Web</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.css">

    <style>
        body { 
            background-color: #212529; 
            color: #ced4da; 
            position: relative; 
            min-height: 100vh; 
            padding-bottom: 60px; 
        }
        
        .container-auth { 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            min-height: calc(100vh - 60px); 
        }
        
        .footer { 
            position: absolute; 
            bottom: 0; 
            width: 100%; 
            white-space: nowrap; 
            line-height: 60px; 
        }
    </style>
</head>
<body>

    <div class="container container-auth py-5">
        <div class="row justify-content-center w-100">
            <div class="col-12 col-md-8 col-lg-5">
                
                <form method="post" asp-action="ForgotPassword" class="border p-4 bg-dark text-light shadow">
                    
                    <div class="text-center mb-4">
                        <h3><i class="bi bi-envelope me-2"></i>Recuperar Contraseña</h3>
                        <p class="small mt-2">Ingresa tu correo electrónico y te enviaremos un enlace para restablecer tu acceso.</p>
                    </div>

                    <div class="mb-4">
                        <input asp-for="Email" class="form-control bg-dark text-light border-secondary" placeholder="ejemplo@correo.com" />
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-secondary fw-bold">Enviar Enlace</button>
                    </div>

                    <div class="text-center mt-4 border-top border-secondary pt-3">
                        <a asp-action="Login" class="text-decoration-none text-muted small">
                            <i class="bi bi-arrow-left me-1"></i> Volver al Login
                        </a>
                    </div>

                </form>
            </div>
        </div>
    </div>

    <footer class="footer text-muted">
        <div class="text-center">
            Created By MAPE <i class="bi bi-star"></i>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>

    <partial name="_Notifications" />
    <partial name="_ValidationScriptsPartial" />

</body>
</html>