@using LXF.Web.Models.ViewModels
@model ResetPasswordViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Restablecer Contraseña - LXF.Web</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.css">

    <style>
        body { 
            background-color: #212529; 
            color: #ced4da; 
            position: relative; 
            min-height: 100vh; 
            padding-bottom: 60px; 
        }
        
        .container-auth { 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            min-height: calc(100vh - 60px); 
        }
        
        .footer { 
            position: absolute; 
            bottom: 0; 
            width: 100%; 
            white-space: nowrap; 
            line-height: 60px; 
        }

        input[type="password"]::-ms-reveal,
        input[type="password"]::-ms-clear,
        input[type="password"]::-webkit-reveal { display: none !important; }
    </style>
</head>
<body>

    <div class="container container-auth py-5">
        <div class="row justify-content-center w-100">
            <div class="col-12 col-md-8 col-lg-5">
                
                <form method="post" asp-action="ResetPassword" class="border p-4 bg-dark text-light shadow">
                    
                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />

                    <div class="text-center mb-4">
                        <h3><i class="bi bi-shield-lock me-2"></i>Nueva Contraseña</h3>
                        <p class="small mt-2">Ingresa tu nueva contraseña para <strong>@Model.Email</strong>.</p>
                    </div>

                    <div class="mb-3">
                        <div class="input-group">
                            <input asp-for="Password" id="passwordInput" type="password" class="form-control bg-dark text-light border-secondary" placeholder="Nueva Contraseña..." />
                            <button class="btn border-secondary bg-dark toggle-password" type="button" data-target="passwordInput">
                                <i class="bi bi-eye-slash text-secondary"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <div class="input-group">
                            <input asp-for="ConfirmPassword" id="confirmPasswordInput" type="password" class="form-control bg-dark text-light border-secondary" placeholder="Repetir Nueva Contraseña..." />
                            <button class="btn border-secondary bg-dark toggle-password" type="button" data-target="confirmPasswordInput">
                                <i class="bi bi-eye-slash text-secondary"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-grid mt-2">
                        <button type="submit" class="btn btn-secondary fw-bold">Guardar Contraseña</button>
                    </div>

                </form>
            </div>
        </div>
    </div>

    <footer class="footer text-muted">
        <div class="text-center">
            Created By MAPE <i class="bi bi-star"></i>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>

    <partial name="_Notifications" />
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function() {
            $('.toggle-password').on('click', function() {
                const targetId = $(this).data('target');
                const $passwordInput = $('#' + targetId);
                const $icon = $(this).find('i');

                if ($passwordInput.attr('type') === 'password') {
                    $passwordInput.attr('type', 'text');
                    $icon.removeClass('bi-eye-slash').addClass('bi-eye');
                } else {
                    $passwordInput.attr('type', 'password');
                    $icon.removeClass('bi-eye').addClass('bi-eye-slash');
                }
            });
        });
    </script>
</body>
</html>