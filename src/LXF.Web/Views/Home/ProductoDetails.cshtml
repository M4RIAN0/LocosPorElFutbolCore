@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {

            let maxStockActual = 1;
            let $inputCantidad = $('#inputCantidad');

            // 1. Selección en Producto Principal
            $('.size-box-main').click(function() {
                if ($(this).hasClass('disabled')) return;

                $('.size-box-main').removeClass('active');
                $(this).addClass('active');

                $('#selectedVariantIdMain').val($(this).data('variant-id'));
                $('#displaySku').text($(this).data('sku'));

                // Extraemos el stock usando isNaN por seguridad
                let st = parseInt($(this).data('stock'));
                maxStockActual = isNaN(st) ? 1 : st;

                $inputCantidad.attr('max', maxStockActual);

                // --- INICIO LÓGICA ESPECIAL CARRO LLENO ---
                if (maxStockActual === 0) {
                    $inputCantidad.val(0);
                    $('#quantityArea').removeClass('d-flex').addClass('d-none');
                    $('#btnAddToCart').addClass('d-none');
                    $('#stockLimitMsg').removeClass('d-none');
                } else {
                    $('#quantityArea').removeClass('d-none').addClass('d-flex');
                    $('#btnAddToCart').removeClass('d-none');
                    $('#stockLimitMsg').addClass('d-none');

                    let valorActual = parseInt($inputCantidad.val()) || 1;

                    if (valorActual > maxStockActual || valorActual === 0) {
                        $inputCantidad.val(maxStockActual);
                    }
                    if (maxStockActual > 1) {
                        $('#stockMsg').text('(' + maxStockActual + ' Disponibles)');
                    } else {
                        $('#stockMsg').text('(' + maxStockActual + ' Disponible)');
                    }
                }
                // --- FIN LÓGICA ESPECIAL CARRO LLENO ---
            });

            // 2. Control manual del Input de Cantidad para permitir teclado
            $inputCantidad.on('keydown', function(e) {
                // Si el stock está en 0 por carro lleno, bloqueamos todo el teclado excepto navegación
                if (maxStockActual === 0) {
                    if (['Backspace', 'Delete', 'Tab', 'ArrowLeft', 'ArrowRight'].includes(e.key)) return;
                    e.preventDefault();
                    return;
                }

                // GESTIONAR FLECHAS ARRIBA Y ABAJO MANUALMENTE
                if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    let val = parseInt(this.value) || 1;
                    if (val < maxStockActual) {
                        this.value = val + 1;
                    }
                    return;
                }

                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    let val = parseInt(this.value) || 1;
                    if (val > 1) {
                        this.value = val - 1;
                    }
                    return;
                }

                // Bloquear caracteres no deseados
                if (['-', '+', '.', 'e', 'E', ','].includes(e.key)) {
                    e.preventDefault();
                }

                // Bloquear tipeo de '0' si la caja está vacía o si están reemplazando todo
                if (e.key === '0' && (this.value === '' || (this.selectionStart === 0 && this.selectionEnd === this.value.length))) {
                    e.preventDefault();
                }
            });

            $inputCantidad.on('input', function() {
                if (maxStockActual === 0) {
                    this.value = 0;
                    return;
                }

                let val = parseInt(this.value);
                if (val > maxStockActual) {
                    this.value = maxStockActual;
                }
            });

            // Si borran la caja, forzamos "1" al instante
            $inputCantidad.on('keyup blur', function() {
                if (maxStockActual === 0) {
                    this.value = 0;
                    return;
                }

                if (this.value === '' || parseInt(this.value) < 1) {
                    this.value = '1';
                    this.select();
                }
            });

            // 3. Selección en los Sliders
            $('.hover-size-box').click(function(e) {
                if ($(this).hasClass('disabled')) return;

                if (e.originalEvent) {
                    e.preventDefault();
                    e.stopPropagation();
                }

                var container = $(this).closest('.slider-sizes-overlay');
                container.find('.hover-size-box').removeClass('active');
                $(this).addClass('active');

                var selectedVariantId = $(this).data('variant-id');
                $(this).closest('form').find('.selected-size-input').val(selectedVariantId);
            });

            // 4. Auto-seleccionar el talle más chico disponible al cargar la página
            $('.sizes-grid .size-box-main:not(.disabled)').first().click();

            $('.slider-card').each(function() {
                $(this).find('.hover-size-box:not(.disabled)').first().click();
            });

            // Validaciones al enviar formulario
            $('#mainAddToCartForm').submit(function(e) {
                if (!$('#selectedVariantIdMain').val()) {
                    e.preventDefault();
                    alert("Por favor, seleccione un talle.");
                }
            });

            $('.cart-slider-form').submit(function(e) {
                var selectedSize = $(this).find('.selected-size-input').val();
                if (!selectedSize) {
                    e.preventDefault();
                    alert("Por favor, selecciona un talle antes de agregar al carrito.");
                }
            });

            // ========================================================
            // AJAX - AGREGAR AL CARRITO (CARRUSELES)
            // ========================================================
            $('.cart-slider-form').submit(function(e) {
                e.preventDefault(); // Evita recargar

                var form = $(this);
                var selectedSize = form.find('.selected-size-input').val();

                if (!selectedSize) {
                    toastr.warning("Por favor, selecciona un talle antes de agregar al carrito.");
                    return false;
                }

                var btn = form.find('.btn-add-cart-slider');
                btn.prop('disabled', true); // Bloqueo silencioso

                $.ajax({
                    url: '/Home/AddToCartAjax',
                    type: 'POST',
                    data: form.serialize(),
                    success: function(response) {
                        if (response.success) {
                            toastr.success(response.message);
                            var dotExists = $('#cart-icon-container').find('.cart-dot').length > 0;
                            if (!dotExists) {
                                $('#cart-icon-container').append('<span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-dark rounded-circle cart-dot"><span class="visually-hidden">Items en carrito</span></span>');
                            }
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function(xhr) {
                        if (xhr.status === 401) { window.location.href = '/Identity/Login'; }
                        else { toastr.error("Ocurrió un error al procesar la solicitud."); }
                    },
                    complete: function() {
                        btn.prop('disabled', false);
                    }
                });
            });

        });
    </script>
}