@using LXF.Web.Models.ViewModels
@model IEnumerable<ProductoGetViewModel>
<form>
    <div class="container row">
        @foreach (var producto in Model){
            <div class="col-12 col-md-6 col-lg-4">
                <div class="p-0 my-3 border rounded">
                <div class="card">
                    <h3 class="card-title text-white-50 text-center py-2">@producto.Nombre</h3>
                    <img src="https://placehold.co/600x400" class="card-img-top">
                    <div class="card-body">
                        <div class="d-flex justify-content-between py-2">
                                <span class="text-danger" style="font-size:20px;">@string.Format("{0:c}", producto.Precio)</span>
                                <span class="badge bg-warning text-white p-2">@producto.Categoria</span>
                        </div>
                        <p class="card-text">@producto.Descripcion</p>
                        <div class="row">
                            <div class="col">
                                <a asp-action="ProductoDetails" asp-route-id="@producto.Id" class="btn btn-success form-control">Detalles</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        }
    </div>
</form>
