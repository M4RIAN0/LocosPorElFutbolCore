@using LXF.Web.Models.ViewModels

@model ProductoViewModel

<form asp-action="ProductoCreate">
    <br />
    <div class="container border p-3">
        <h1 class="text-white text-center">Crear Producto</h1>

        <hr />
        <div class="row">
            <div class="col-2">
                <label class="control-label pt-2" style="font-size:20px;">Descripcion</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="Descripcion" class="form-control" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
            <div class="col-2">
                <label class="control-label pt-2" style="font-size:20px;">Marca</label>
            </div>
            <div class="col-10 pb-3">
                <select asp-for="MarcaId" class="form-select" asp-items="@ViewBag.Marcas">
                    <option disabled selected>--Seleccionar Marca--</option>
                </select>
            </div>
            <div class="col-2">
                <label class="control-label pt-2" style="font-size:20px;">Talle</label>
            </div>
           <div class="col-10 pb-3">
                <select asp-for="TalleId" class="form-select" asp-items="@ViewBag.Talles">
                    <option disabled selected>--Seleccionar Talle--</option>
                </select>
            </div>
            <div class="col-2">
                <label class="control-label pt-2" style="font-size:20px;">Precio</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="Precio" class="form-control" />
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>
            <div class="col-2">
                <label class="control-label pt-2" style="font-size:20px;">Stock</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="Stock" class="form-control" />
                <span asp-validation-for="Stock" class="text-danger"></span>
            </div>
            <div class="col-2">
                <label class="control-label pt-2" style="font-size:20px;">CodigoBarra</label>
            </div>
            <div class="col-10 pb-3">
                <input asp-for="CodigoBarra" class="form-control" />
                <span asp-validation-for="CodigoBarra" class="text-danger"></span>
            </div>
            <div class="col-2">
                <label class="control-label pt-2" style="font-size:20px;">Categoria</label>
            </div>
            <div class="col-10 pb-3">
                <select asp-for="CategoriaId" class="form-select" asp-items="@ViewBag.Categorias">
                    <option disabled selected>--Seleccionar Categoria--</option>
                </select>
            </div>

            <div class="col-5 offset-2">

                <a asp-action="ProductoIndex" class="btn-primary btn form-control ">Volver a la Lista</a>
            </div>
            <div class="col-5">
                <input type="submit" value="Crear" class="btn btn-success form-control" />
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}